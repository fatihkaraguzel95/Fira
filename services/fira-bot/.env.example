# Fira botu ayarlari — kopyala: cp .env.example .env  (.env git'e girmez)
#
# Uretimde bu dosya /etc/fira-bot.env olarak, mode 600, root'un sahipliginde durur.
# Lokalde gelistirirken BotFather'dan ayri bir test botu al: ayni token ile iki
# getUpdates acilamaz, canli botu durdurmak zorunda kalmazsin.

TELEGRAM_BOT_TOKEN=

# Supabase. Bos birakilirsa uygulamanin projesi kullanilir.
SUPABASE_URL=https://zkyegeioiyxaiamugbjt.supabase.co

# Yeni anahtar duzeninde: sb_publishable_... ve sb_secret_...
# Eski duzende: iki uzun JWT (anon + service_role).
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Varsa doldur: Dashboard -> Project Settings -> JWT Keys -> JWT Secret.
# Varsa kullanici token'i yerelde imzalanir (hizli yol). Yoksa bos birak:
# bot Auth admin API ile gercek oturum alir, calismasi icin sart degil.
SUPABASE_JWT_SECRET=

# Mesajlardaki "Fira'da ac" baglantisinin koku
FIRA_BASE_URL=https://fira.flpconsulting.de

# Uzun yoklama suresi ve yarim kalan konusmanin omru (dakika)
POLL_TIMEOUT_SECONDS=25
DRAFT_TTL_MINUTES=120

# ── Yapay zeka (NVIDIA NIM, OpenAI uyumlu uc) ───────────────────────────────
# Anahtar bostaysa sohbet kapali kalir; dugmeli /yeni akisi calismaya devam eder.
NVIDIA_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ── Gorevlerin acilacagi yer ────────────────────────────────────────────────
# Virgulle ayrilmis aday liste adlari; ilk eslesen kullanilir. Kullanici /hedef
# ile sectiginde secim veritabanina yazilir ve bu adlara bir daha bakilmaz.
FIRA_PROJECT=Uygulama hata analizi,SportIQ
# Gorevin dusecegi sutun. Sorulmaz: her gorev bu sutuna acilir. Ad tutmazsa
# "yapilacak / to do" esanlamlilari, sonra backlog kategorisindeki sutun denenir.
FIRA_STATUS=Yapilacaklar
